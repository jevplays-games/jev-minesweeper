[Unit]
Description=Minesweeper vs JEV
After=network.target

[Service]
Type=simple
User=jev
Group=jev
WorkingDirectory=/opt/jev-arcade
EnvironmentFile=/etc/jev-arcade.env
ExecStart=/usr/bin/node /opt/jev-arcade/server/main.js
Restart=on-failure
RestartSec=3
TimeoutStopSec=30
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/var/lib/jev-arcade

[Install]
WantedBy=multi-user.target
