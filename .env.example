# Local development: copy to .env. No keys are needed for local-opponent practice.
HOST=127.0.0.1
PORT=3000
APP_ORIGIN=http://localhost:3000
NODE_ENV=development
DATABASE_PATH=data/minesweeper.sqlite

# Actual TypeSafe/JEV integration. Keep blank for clearly labeled local practice.
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=3000
MAX_JEV_CALLS_PER_MATCH=250
MAX_ACTIVE_MATCHES=8

# Optional estimate only. Blank produces null cost, not an invented price.
JEV_INPUT_PRICE_PER_MILLION=

# Discord application. User login uses identify; guild installation uses commands.
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
# Registration script only: blank registers globally; set for a test guild.
DISCORD_TEST_GUILD_ID=

# Optional read-only operational analytics endpoint; use a random secret.
ANALYTICS_ADMIN_TOKEN=
# Audit retention only. Sealed match/replay data is retained until operator deletion.
RETENTION_DAYS=30
# Set to 1 only behind the documented trusted loopback reverse proxy.
TRUST_PROXY=0
