# Local development only (`npm start`). On Cloudflare these are Worker vars (wrangler.jsonc) and secrets (`wrangler secret put`).
# The shim binds loopback and the origin must be the exact host you browse (localhost and 127.0.0.1 are different origins).
PORT=3000
APP_ORIGIN=http://localhost:3000
# Optional locally (a fixed development salt is used); REQUIRED as a secret in production.
RATE_LIMIT_SALT=
TYPESAFE_API_KEY=
JEV_MODEL=jev-1.13.0
JEV_TIMEOUT_MS=3000
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
DISCORD_PUBLIC_KEY=
# Only for `npm run discord:register`: register in this guild for instant availability (empty = global, up to an hour).
DISCORD_TEST_GUILD_ID=
# Bearer token for GET /api/admin/analytics (aggregate operator metrics). Empty disables the endpoint.
ANALYTICS_ADMIN_TOKEN=
# Explicit estimate, not a bill. Set to your actual contract's input token price (per million tokens).
JEV_INPUT_PRICE_PER_MILLION=
API_REQUESTS_PER_MINUTE=3000
MAX_ACTIVE_MATCHES=8
MAX_JEV_CALLS_PER_MATCH=250
MAX_JEV_CALLS_PER_DAY=5000
MAX_MATCHES_PER_DAY=300
# Local SQLite file (defaults to data/minesweeper.sqlite).
DATABASE_PATH=
